@model IEnumerable<IndianBank.Models.AccountDetailsViewModel>
@{
    ViewData["Title"] = "Dashboard";
}
<h2>Dashboard</h2>
@if (!User.Identity.IsAuthenticated)
{
    <p>Please <a href="@Url.Action("Login", "Account")">login</a> or <a href="@Url.Action("Signup", "Account")">sign up</a>.</p>
}
else
{
    <h4>Your accounts</h4>
    <ul>
        @foreach (var a in Model)
        {
            <li>@a.AccountId — Balance: @a.Balance ----- AccoountType: @a.AccountType</li>
        }
    </ul>
}

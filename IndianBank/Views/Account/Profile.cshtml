@model IndianBank.Models.UserViewModel
@{
    ViewData["Title"] = "Profile";
}

<h2>Profile</h2>
<div class="card">
    <div class="card-body">
        <h5>@Model.FullName</h5>
        <p>Email: @Model.Email</p>
        <p>Accounts:</p>
        <ul>
            @foreach (var a in Model.AccountDetails)
            {
                <li>Account #: @a.AccountId — Balance: @a.Balance</li>
            }
        </ul>
        <a class="btn btn-primary" href="@Url.Action("Edit")">Edit profile</a>
    </div>
</div>
